{
  "name": "whatsapp-export-viewer",
  "version": "1.0.0",
  "description": "A cross-platform desktop application for importing, parsing, and viewing WhatsApp chat exports locally, built with Electron, React, Node.js, and SQLite.",
  "homepage": "https://github.com/Muntazir3i/whatsapp-export-viewer#readme",
  "bugs": {
    "url": "https://github.com/Muntazir3i/whatsapp-export-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muntazir3i/whatsapp-export-viewer.git"
  },
  "license": "ISC",
  "author": {
    "name": "MDOT",
    "email": "mohammadmunti.5@gmail.com"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "renderer:dev": "npm run dev --prefix renderer",
    "renderer:build": "npm run build --prefix renderer",
    "electron:dev": "ELECTRON_DEV=true electron .",
    "dev": "concurrently \"npm run renderer:dev\" \"wait-on http://localhost:5174 && npm run electron:dev\"",
    "build": "npm run renderer:build && electron-builder",
    "build:win": "npm run renderer:build && electron-builder --win",
    "build:mac": "npm run renderer:build && electron-builder --mac",
    "build:linux": "npm run renderer:build && electron-builder --linux",
    "electron": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "build": {
    "appId": "com.mdot.whatsapp-export-viewer",
    "productName": "WhatsApp Export Viewer",
    "copyright": "Copyright © 2024 MDOT",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
